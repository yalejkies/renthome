
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/(assets|uploads|certs)/(.*)$",
      "dest": "/$1/$2"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php?__route=$1"
    }
  ]
}
